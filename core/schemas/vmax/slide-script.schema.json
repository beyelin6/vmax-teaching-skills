{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/beyelin6/vmax-teaching-skills/main/core/schemas/vmax/slide-script.schema.json",
  "title": "V-MAX Slide Script",
  "type": "object",
  "required": ["object_type", "lesson_id", "source_master_version", "approved_selection_version", "version", "slides", "derived_from", "canvas_lock"],
  "properties": {
    "object_type": {"const": "SLIDE_SCRIPT"},
    "lesson_id": {"type": "string"},
    "source_master_version": {"type": "string"},
    "approved_selection_version": {"type": "string"},
    "version": {"type": "string"},
    "canvas_lock": {"$ref": "#/$defs/canvasLock"},
    "slides": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_id", "sequence", "student_layer", "teacher_layer", "qa_layer", "object_composition_plan", "character_plan", "key_line_plan"],
        "properties": {
          "slide_id": {"type": "string"}, "sequence": {"type": "integer", "minimum": 1},
          "student_layer": {"type": "object"}, "teacher_layer": {"type": "object"}, "qa_layer": {"type": "object"},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "page_class": {"enum": ["TEXT_READING_PAGE", "IMAGE_COMPOSED_PAGE"]},
          "page_family": {"type": "string"}, "style_variant": {"type": "string"},
          "object_composition_plan": {"$ref": "#/$defs/objectCompositionPlan"},
          "character_plan": {"$ref": "#/$defs/characterPlan"},
          "key_line_plan": {"$ref": "#/$defs/keyLinePlan"},
          "idiom_application_plan": {"$ref": "#/$defs/idiomApplicationPlan"},
          "vocab_mark_plan": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/vocabMark"}},
          "text_layout_revision": {"type": "string", "minLength": 1},
          "term_color_map": {"type": "object", "additionalProperties": {"type": "string"}},
          "image_layout_plan": {"description": "Legacy compatibility summary only.", "type": "object"},
          "visual_density_profile": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "text_rendering": {"type": "object"}, "render_request": {"type": "object"}
        },
        "allOf": [
          {"if": {"required": ["vocab_mark_plan"]}, "then": {"required": ["text_layout_revision"]}},
          {"if": {"properties": {"page_family": {"const": "IDIOM"}}, "required": ["page_family"]}, "then": {"required": ["idiom_application_plan"]}}
        ],
        "additionalProperties": false
      }
    },
    "derived_from": {"type": "object"},
    "presentation_rendering_policy": {"type": "object"}
  },
  "$defs": {
    "canvasLock": {"type": "object", "required": ["profile", "ratio", "width_px", "height_px", "orientation", "safe_area", "fit_mode", "output_formats", "teacher_decision_ref"], "properties": {"profile": {"type": "string"}, "ratio": {"enum": ["4:3", "16:9"]}, "width_px": {"type": "integer"}, "height_px": {"type": "integer"}, "orientation": {"const": "LANDSCAPE"}, "safe_area": {"type": "string"}, "fit_mode": {"type": "string"}, "output_formats": {"type": "array"}, "teacher_decision_ref": {"type": "string"}}},
    "objectCompositionPlan": {"type": "object", "required": ["composition_mode", "background_role", "text_objects", "primary_visual_object", "supporting_visual_objects", "character_objects", "annotation_objects", "layer_order", "planned_overlaps", "protected_zones", "organic_edge_strategy"], "properties": {"composition_mode": {"enum": ["OBJECT_SCENE", "IMMERSIVE_FULL_SCENE"]}, "background_role": {"type": "string"}, "text_objects": {"type": "array"}, "primary_visual_object": {}, "supporting_visual_objects": {"type": "array"}, "character_objects": {"type": "array"}, "annotation_objects": {"type": "array"}, "layer_order": {"type": "array"}, "planned_overlaps": {"type": "array"}, "protected_zones": {"type": "array"}, "organic_edge_strategy": {"type": "string"}}},
    "characterPlan": {"type": "object", "required": ["appear"], "properties": {"appear": {"type": "boolean"}, "character": {}, "character_type": {"enum": ["CANONICAL_CHARACTER", "SEMANTIC_SUPPORTING_FIGURE", "NONE"]}, "role": {}, "position": {}, "scale": {}, "facing": {}, "action": {}, "speech_mode": {}, "overlap_mode": {"enum": ["SEPARATE_OBJECT", "SCENE_INTEGRATED", "FOREGROUND_OVERLAP", "NONE"]}, "overlap_targets": {}, "avoid_zone": {}}},
    "keyLinePlan": {"type": "object", "required": ["use", "source"], "properties": {"use": {"type": "boolean"}, "source": {"enum": ["TEXTBOOK", "TEACHER", "AI_TRANSITION", "NONE"]}, "text": {}, "function": {}, "placement": {}, "hierarchy": {}, "relation_to_character": {}}},
    "idiomApplicationPlan": {
      "type": "object",
      "required": ["idiom", "student_friendly_meaning", "example_sentence", "example_scene_subject", "example_scene_action", "semantic_relation", "literal_image_risk", "source_refs"],
      "properties": {
        "idiom": {"type": "string", "minLength": 1},
        "student_friendly_meaning": {"type": "string", "minLength": 1},
        "example_sentence": {"type": "string", "minLength": 1},
        "example_scene_subject": {"type": "string", "minLength": 1},
        "example_scene_action": {"type": "string", "minLength": 1},
        "semantic_relation": {"type": "string", "minLength": 1},
        "literal_image_risk": {"type": ["string", "boolean"]},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }, "additionalProperties": false
    },
    "vocabMark": {"type": "object", "required": ["term_text", "source_ref", "term_color_id", "mark_mode", "occurrence_index", "text_layout_revision"], "properties": {"term_text": {"type": "string"}, "source_ref": {"type": "string"}, "term_color_id": {"type": "string"}, "mark_mode": {"const": "UNDERLINE_HIGHLIGHT"}, "occurrence_index": {"type": "integer", "minimum": 1}, "start_char_index": {"type": "integer"}, "end_char_index": {"type": "integer"}, "glyph_bbox": {"type": ["object", "null"]}, "baseline_y": {"type": ["number", "null"]}, "mark_bbox": {"type": ["object", "null"]}, "text_layout_revision": {"type": "string"}}, "additionalProperties": true}
  },
  "additionalProperties": false
}