{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/beyelin6/vmax-teaching-skills/main/core/schemas/vmax/slide-script.schema.json",
  "title": "V-MAX Slide Script",
  "type": "object",
  "required": ["object_type", "lesson_id", "source_master_version", "approved_selection_version", "version", "slides", "derived_from", "canvas_lock"],
  "properties": {
    "object_type": { "const": "SLIDE_SCRIPT" },
    "lesson_id": { "type": "string" },
    "source_master_version": { "type": "string" },
    "approved_selection_version": { "type": "string" },
    "version": { "type": "string" },
    "status": { "enum": ["BATCH_DRAFT", "TEACHER_REVIEW", "LESSON_LOCKED", "OUTPUT_DRAFT", "OUTPUT_QA", "APPROVED_OUTPUT", "SUPERSEDED"] },
    "teacher_confirmation_status": { "enum": ["NOT_REVIEWED", "WAITING_TEACHER", "CONFIRMED", "CHANGES_REQUESTED"] },
    "canvas_lock": { "$ref": "#/$defs/canvasLock" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_id", "sequence", "student_layer", "teacher_layer", "qa_layer"],
        "properties": {
          "slide_id": { "type": "string" },
          "sequence": { "type": "integer", "minimum": 1 },
          "student_layer": { "type": "object" },
          "teacher_layer": { "type": "object" },
          "qa_layer": { "type": "object" },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "layout_direction": { "enum": ["TEXT_LEFT_IMAGE_RIGHT", "IMAGE_LEFT_TEXT_RIGHT", "OTHER_CONFIRMED_LAYOUT"] },
          "visual_layer": { "type": "object" },
          "image_layout_plan": {
            "type": "object",
            "properties": {
              "primary_visual_id": { "type": "string" },
              "supporting_visual_ids": { "type": "array", "items": { "type": "string" } },
              "text_region": { "type": "string" },
              "negative_space_region": { "type": "string" },
              "gutter_policy": { "type": "string" },
              "split_if_overloaded": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "visual_density_profile": { "enum": ["LOW", "MEDIUM", "HIGH"] },
          "text_rendering": {
            "type": "object",
            "properties": {
              "mode": { "enum": ["CONTROLLED_NATIVE_TEXT_READING_PAGE", "VERIFIED_RASTER_TEXT_LAYERS", "NATIVE_TEXT_DERIVED_PPTX"] },
              "layers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["layer_id", "text", "visibility", "source_ref"],
                  "properties": {
                    "layer_id": { "type": "string" },
                    "text": { "type": "string" },
                    "visibility": { "enum": ["STUDENT", "TEACHER", "QA", "HIDDEN"] },
                    "source_ref": { "type": "string" },
                    "position": { "type": "object" },
                    "style": { "type": "object" },
                    "transparent_background": { "const": true },
                    "anchor_relation": { "type": "string" },
                    "container_type": { "type": "string" },
                    "font_file": { "type": "string" },
                    "font_size_pt": { "type": "number", "exclusiveMinimum": 0 },
                    "line_height": { "type": "number", "exclusiveMinimum": 0 },
                    "z_order": { "type": "integer" },
                    "proof_status": { "enum": ["UNCHECKED", "PROOFED", "EMBEDDED", "VERIFIED"] },
                    "repair_scope": { "const": "LOCAL_LAYER_ONLY" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "render_request": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "derived_from": {
      "type": "object",
      "required": ["direct_parent", "lineage"],
      "properties": {
        "direct_parent": { "type": "string" },
        "lineage": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "presentation_rendering_policy": {
      "type": "object",
      "properties": {
        "student_visual_default": { "const": "VERIFIED_RASTER_TEXT_LAYERS" },
        "source_text_authority": { "const": "VERIFIED_TEACHING_TEXT" },
        "editable_text_output": { "const": "DERIVED_ONLY" },
        "local_text_repair": { "const": true },
        "canvas_aspect_ratio": { "enum": ["4:3", "16:9"] },
        "orientation": { "const": "LANDSCAPE" },
        "page_number_system": {
          "type": "object",
          "properties": {
            "position": { "type": "string" },
            "format": { "type": "string" },
            "style_ref": { "type": "string" },
            "font_role": { "type": "string" },
            "color_role": { "type": "string" },
            "visibility_policy": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "canvasLock": {
      "type": "object",
      "required": ["profile", "ratio", "width_px", "height_px", "orientation", "safe_area", "fit_mode", "output_formats", "teacher_decision_ref"],
      "properties": {
        "profile": { "enum": ["lesson_presentation_16_9_v1", "lesson_presentation_4_3_v1"] },
        "ratio": { "enum": ["4:3", "16:9"] },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 },
        "orientation": { "const": "LANDSCAPE" },
        "safe_area": { "type": "string" },
        "fit_mode": { "enum": ["PRESERVE_ASPECT_CONTAIN_OR_APPROVED_CROP"] },
        "output_formats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["PNG", "PDF", "PPTX"] } },
        "teacher_decision_ref": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
