{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vmax.local/schemas/cloud-checkpoint.schema.json",
  "title": "V-MAX Cloud Checkpoint Manifest",
  "type": "object",
  "required": ["object_type", "checkpoint_id", "status", "stage", "artifacts", "uploaded_files_verified"],
  "properties": {
    "object_type": {"const": "CLOUD_CHECKPOINT_MANIFEST"},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PENDING", "UPLOADING", "VERIFIED", "BLOCKED"]},
    "stage": {"type": "string", "minLength": 1},
    "teacher_decision": {"type": "string"},
    "previous_state": {"type": "string"},
    "next_legal_stage": {"type": "string"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "sha256", "revision", "drive_file_id"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "revision": {"type": "string", "minLength": 1},
          "drive_file_id": {"type": "string", "minLength": 1},
          "drive_url": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "uploaded_files_verified": {"enum": ["PASS", "INCOMPLETE", "BLOCKED"]}
  },
  "additionalProperties": true
}
